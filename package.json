{
  "name": "p2p-collab-draw",
  "version": "0.1.2",
  "description": "Real-time collaborative SVG drawing app with WebRTC P2P and Yjs CRDT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:all": "npm run typecheck && npm run test:unit && npm run build && npm run test:e2e"
  },
  "author": "Joaquin Vergara",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/joverval/p2p-collab-draw"
  },
  "dependencies": {
    "@joverval/p2p-collab": "file:../p2p-collab",
    "y-websocket": "^1.5.2",
    "yjs": "^13.6.31"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
